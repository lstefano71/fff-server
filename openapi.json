{
  "openapi": "3.1.0",
  "info": {
    "title": "fff-server",
    "description": "Typed HTTP access to the fff file-search engine.",
    "license": {
      "name": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Server is answering",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workspaces": {
      "get": {
        "tags": [
          "workspaces"
        ],
        "summary": "List live workspaces.",
        "operationId": "list",
        "responses": {
          "200": {
            "description": "Live workspaces",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceList"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "workspaces"
        ],
        "summary": "Create or warm a workspace.",
        "description": "Returns `201` when the index reached the requested readiness stage inside the block\nbudget, and `202` when it did not — the resource is returned either way, and a `202`\nmeans poll `GET /v1/workspaces/{id}` rather than that anything failed.",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWorkspace"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Workspace ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceResource"
                }
              }
            }
          },
          "202": {
            "description": "Workspace still indexing; poll the resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceResource"
                }
              }
            }
          },
          "400": {
            "description": "Root missing, not a directory, or too long",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Root refused: filesystem/share root, or outside allowed_roots",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Database already in use for this root",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workspaces/{id}": {
      "get": {
        "tags": [
          "workspaces"
        ],
        "summary": "Fetch one workspace, including current readiness. This is the poll target after a `202`.",
        "operationId": "get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Workspace id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceResource"
                }
              }
            }
          },
          "404": {
            "description": "No such workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "workspaces"
        ],
        "summary": "Evict a workspace now, releasing its index, watcher threads and database handles.",
        "operationId": "delete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Workspace id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Evicted"
          },
          "404": {
            "description": "No such workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workspaces/{id}/glob": {
      "post": {
        "tags": [
          "search"
        ],
        "summary": "Literal glob match, frecency-ranked, bypassing the query parser.",
        "operationId": "glob",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Workspace id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GlobRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Matching files",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid glob pattern",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Index not ready yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workspaces/{id}/search": {
      "post": {
        "tags": [
          "search"
        ],
        "summary": "Fuzzy file search.",
        "operationId": "search",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Workspace id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Ranked file matches",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Index not ready yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workspaces/{id}/search/directories": {
      "post": {
        "tags": [
          "search"
        ],
        "summary": "Fuzzy directory search.",
        "operationId": "search_directories",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Workspace id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Ranked directory matches",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirSearchResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Index not ready yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workspaces/{id}/search/mixed": {
      "post": {
        "tags": [
          "search"
        ],
        "summary": "Fuzzy search over files and directories together.",
        "operationId": "search_mixed",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Workspace id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Ranked file and directory matches",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MixedSearchResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Index not ready yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CacheBudget": {
        "type": "object",
        "properties": {
          "maxBytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "maxFileSize": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "maxFiles": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "CreateWorkspace": {
        "type": "object",
        "description": "Per-workspace options, all defaulting from `[defaults]` in the config file.",
        "required": [
          "root"
        ],
        "properties": {
          "aiMode": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "`FFFMode::Ai` when true. Changes frecency decay, modification-score thresholds and\nwatcher event handling. Fixed for the workspace's life."
          },
          "cacheBudget": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CacheBudget",
                "description": "Explicit content-cache budget. Omitted, fff sizes it from the file count."
              }
            ]
          },
          "contentIndexing": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Builds the bigram content index (~360 bytes/file). Required for typo-resistant and\nfuzzy grep. Measured at roughly 20x the cost of the directory walk."
          },
          "followSymlinks": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "gitRecency": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/GitRecency",
                "description": "Ranking boost for files in recent commits on the current branch."
              }
            ]
          },
          "root": {
            "type": "string",
            "description": "Path to index. Any spelling; it is canonicalised and deduplicated by filesystem\nidentity, so a UNC path and a mapped drive pointing at one directory give one\nworkspace."
          },
          "waitFor": {
            "$ref": "#/components/schemas/WaitFor",
            "description": "Which readiness stage to block for."
          },
          "waitForIndexMs": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Overrides `workspaces.create_block_ms` for this call.",
            "minimum": 0
          },
          "watch": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Background filesystem watcher. Verified working over SMB (~500ms)."
          }
        },
        "additionalProperties": false
      },
      "DirHit": {
        "type": "object",
        "required": [
          "item",
          "score"
        ],
        "properties": {
          "item": {
            "$ref": "#/components/schemas/DirItemDto"
          },
          "score": {
            "$ref": "#/components/schemas/ScoreDto"
          }
        }
      },
      "DirItemDto": {
        "type": "object",
        "description": "An indexed directory.",
        "required": [
          "relativePath",
          "dirName",
          "absolutePath",
          "maxAccessFrecency"
        ],
        "properties": {
          "absolutePath": {
            "type": "string"
          },
          "dirName": {
            "type": "string"
          },
          "maxAccessFrecency": {
            "type": "integer",
            "format": "int32",
            "description": "Highest access-frecency score among the files beneath it."
          },
          "relativePath": {
            "type": "string",
            "description": "Forward slashes, with a trailing `/`."
          }
        }
      },
      "DirSearchResponse": {
        "type": "object",
        "required": [
          "items",
          "totalMatched",
          "totalDirs",
          "page",
          "pageSize",
          "hasMore"
        ],
        "properties": {
          "hasMore": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DirHit"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "pageSize": {
            "type": "integer",
            "minimum": 0
          },
          "totalDirs": {
            "type": "integer",
            "minimum": 0
          },
          "totalMatched": {
            "type": "integer",
            "minimum": 0
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "EffectiveOptions": {
        "type": "object",
        "description": "The settings a workspace was actually created with, echoed back so a client never has to\nguess which defaults applied.",
        "required": [
          "aiMode",
          "contentIndexing",
          "watch",
          "followSymlinks",
          "gitRecencyEnabled",
          "gitRecencyMaxCommits",
          "gitRecencyMaxFilesPerCommit"
        ],
        "properties": {
          "aiMode": {
            "type": "boolean"
          },
          "contentIndexing": {
            "type": "boolean"
          },
          "followSymlinks": {
            "type": "boolean"
          },
          "gitRecencyEnabled": {
            "type": "boolean"
          },
          "gitRecencyMaxCommits": {
            "type": "integer",
            "minimum": 0
          },
          "gitRecencyMaxFilesPerCommit": {
            "type": "integer",
            "minimum": 0
          },
          "watch": {
            "type": "boolean"
          }
        }
      },
      "FileItemDto": {
        "type": "object",
        "description": "An indexed file.",
        "required": [
          "relativePath",
          "fileName",
          "directory",
          "absolutePath",
          "size",
          "modified",
          "isBinary",
          "accessFrecencyScore",
          "modificationFrecencyScore",
          "gitRecencyScore",
          "totalFrecencyScore",
          "gitStatus"
        ],
        "properties": {
          "absolutePath": {
            "type": "string",
            "description": "Native separators, and free of any `\\\\?\\` prefix — so it is safe to open and safe to\ndisplay. Not an identity key.",
            "example": "\\\\server\\share\\project\\src\\main.rs"
          },
          "accessFrecencyScore": {
            "type": "integer",
            "format": "int32"
          },
          "directory": {
            "type": "string",
            "description": "Parent directory, with a trailing `/`. Empty at the root."
          },
          "fileName": {
            "type": "string"
          },
          "gitRecencyScore": {
            "type": "integer",
            "format": "int32",
            "description": "Boost from recent commits on the current branch. Reported separately because\n`totalFrecencyScore` does **not** include it, so it would otherwise be invisible."
          },
          "gitStatus": {
            "$ref": "#/components/schemas/GitStatus"
          },
          "isBinary": {
            "type": "boolean"
          },
          "modificationFrecencyScore": {
            "type": "integer",
            "format": "int32"
          },
          "modified": {
            "type": "string",
            "format": "date-time"
          },
          "relativePath": {
            "type": "string",
            "description": "Repo-relative, **forward slashes on every platform**, carrying on-disk casing. This\nis what the engine stores and what globs and path constraints match against.",
            "example": "crates/fff-core/src/types.rs"
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "totalFrecencyScore": {
            "type": "integer",
            "format": "int32",
            "description": "Access plus modification only — deliberately excluding `gitRecencyScore`, matching\nthe engine's own `total_frecency_score()`."
          }
        }
      },
      "GitRecency": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "maxCommits": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Commits to look back over. fff caps this at 128 internally.",
            "minimum": 0
          },
          "maxFilesPerCommit": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Commits touching more files than this are ignored, so a sweeping commit does not\nboost the whole tree.",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "GitStatus": {
        "type": "object",
        "description": "Git status, in full.\n\n`git2::Status` is a bitflags value — a file can be staged-modified *and* worktree-modified\nat once. Every other fff binding flattens it to one string and loses that, so both forms\nare emitted: `status` for convenience, `flags` for fidelity.",
        "required": [
          "status",
          "flags"
        ],
        "properties": {
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Every set bit, so a client can see combinations the single label hides.",
            "example": [
              "stagedModified",
              "modified"
            ]
          },
          "status": {
            "type": "string",
            "description": "fff's own single-label vocabulary: `clean`, `modified`, `untracked`, `staged_new`,\n`staged_modified`, `staged_deleted`, `deleted`, `renamed`, `ignored`, `unknown`.",
            "example": "modified"
          }
        }
      },
      "GitStatusConstraint": {
        "type": "string",
        "description": "Git status filter, mirroring the engine's four categories.",
        "enum": [
          "modified",
          "untracked",
          "staged",
          "unmodified"
        ]
      },
      "GlobRequest": {
        "type": "object",
        "description": "Glob-only request. Bypasses the query parser entirely: the pattern is used literally,\nresults are frecency-ranked. Use it when the pattern is already a glob and fuzzy\nmatching on top would only add noise.",
        "required": [
          "pattern"
        ],
        "properties": {
          "currentFile": {
            "type": [
              "string",
              "null"
            ]
          },
          "maxThreads": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "page": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "pageSize": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "pattern": {
            "type": "string",
            "description": "Forward slashes only — the matcher does not treat `\\` as a separator.",
            "example": "**/*.rs"
          }
        },
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "description": "Server liveness and, once the pool exists, per-workspace readiness.",
        "required": [
          "status",
          "version",
          "engineVersion",
          "uptimeSeconds",
          "workspaceCount"
        ],
        "properties": {
          "engineVersion": {
            "type": "string",
            "description": "The `fff-search` release this binary is built against.",
            "example": "0.11.0"
          },
          "status": {
            "type": "string",
            "description": "Always `\"ok\"` when the process is answering.",
            "example": "ok"
          },
          "uptimeSeconds": {
            "type": "integer",
            "format": "int64",
            "description": "Seconds since process start.",
            "minimum": 0
          },
          "version": {
            "type": "string",
            "description": "This server's version."
          },
          "workspaceCount": {
            "type": "integer",
            "description": "Number of live workspaces in the pool.",
            "minimum": 0
          }
        }
      },
      "LineCol": {
        "type": "object",
        "required": [
          "line",
          "col"
        ],
        "properties": {
          "col": {
            "type": "integer",
            "format": "int32"
          },
          "line": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "LocationDto": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "line",
              "type"
            ],
            "properties": {
              "line": {
                "type": "integer",
                "format": "int32"
              },
              "type": {
                "type": "string",
                "enum": [
                  "line"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "line",
              "col",
              "type"
            ],
            "properties": {
              "col": {
                "type": "integer",
                "format": "int32"
              },
              "line": {
                "type": "integer",
                "format": "int32"
              },
              "type": {
                "type": "string",
                "enum": [
                  "position"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "start",
              "end",
              "type"
            ],
            "properties": {
              "end": {
                "$ref": "#/components/schemas/LineCol"
              },
              "start": {
                "$ref": "#/components/schemas/LineCol"
              },
              "type": {
                "type": "string",
                "enum": [
                  "range"
                ]
              }
            }
          }
        ],
        "description": "A `file.ts:42:10` suffix parsed out of the query. The MCP server discards this entirely."
      },
      "MixedHit": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "item",
              "score",
              "type"
            ],
            "properties": {
              "item": {
                "$ref": "#/components/schemas/FileItemDto"
              },
              "score": {
                "$ref": "#/components/schemas/ScoreDto"
              },
              "type": {
                "type": "string",
                "enum": [
                  "file"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "item",
              "score",
              "type"
            ],
            "properties": {
              "item": {
                "$ref": "#/components/schemas/DirItemDto"
              },
              "score": {
                "$ref": "#/components/schemas/ScoreDto"
              },
              "type": {
                "type": "string",
                "enum": [
                  "directory"
                ]
              }
            }
          }
        ],
        "description": "A hit from a mixed search, tagged by kind."
      },
      "MixedSearchResponse": {
        "type": "object",
        "required": [
          "items",
          "totalMatched",
          "totalFiles",
          "totalDirs",
          "page",
          "pageSize",
          "hasMore"
        ],
        "properties": {
          "hasMore": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MixedHit"
            }
          },
          "location": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LocationDto"
              }
            ]
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "pageSize": {
            "type": "integer",
            "minimum": 0
          },
          "totalDirs": {
            "type": "integer",
            "minimum": 0
          },
          "totalFiles": {
            "type": "integer",
            "minimum": 0
          },
          "totalMatched": {
            "type": "integer",
            "minimum": 0
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem details. ASP.NET Core deserialises this into `ProblemDetails` with no\nclient-side code.\n\nClients switch on `code`, never on `detail`: `code` is a stable identifier, `detail` is\nprose from the engine and may change between fff releases.",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable code. Switch on this.",
            "example": "invalid-path"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "Prose explanation for this occurrence. Not stable; do not parse."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status code, repeated here as RFC 9457 specifies.",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Short, human-readable summary of the error class."
          },
          "type": {
            "type": "string",
            "description": "Stable URN identifying the error class.",
            "example": "urn:fff-server:error:invalid-path"
          }
        }
      },
      "ScoreDto": {
        "type": "object",
        "description": "The complete score breakdown: all 13 fields the engine computes.",
        "required": [
          "total",
          "baseScore",
          "filenameBonus",
          "specialFilenameBonus",
          "frecencyBoost",
          "gitStatusBoost",
          "gitRecencyBoost",
          "distancePenalty",
          "currentFilePenalty",
          "comboMatchBoost",
          "pathAlignmentBonus",
          "exactMatch",
          "matchType"
        ],
        "properties": {
          "baseScore": {
            "type": "integer",
            "format": "int32"
          },
          "comboMatchBoost": {
            "type": "integer",
            "format": "int32"
          },
          "currentFilePenalty": {
            "type": "integer",
            "format": "int32"
          },
          "distancePenalty": {
            "type": "integer",
            "format": "int32"
          },
          "exactMatch": {
            "type": "boolean"
          },
          "filenameBonus": {
            "type": "integer",
            "format": "int32"
          },
          "frecencyBoost": {
            "type": "integer",
            "format": "int32"
          },
          "gitRecencyBoost": {
            "type": "integer",
            "format": "int32",
            "description": "Added in fff 0.11; absent from every other binding."
          },
          "gitStatusBoost": {
            "type": "integer",
            "format": "int32",
            "description": "Dropped by the C ABI and by the TypeScript SDK."
          },
          "matchType": {
            "type": "string",
            "description": "Documented as an **open** string, not a closed enum: it is a bare `&'static str` in\nthe engine with no enum backing it, so a future value must not break a client.\nKnown values include `fuzzy`, `fuzzy_filename`, `exact`, `prefix`, `path`.",
            "example": "fuzzy_filename"
          },
          "pathAlignmentBonus": {
            "type": "integer",
            "format": "int32",
            "description": "Dropped by the TypeScript SDK."
          },
          "specialFilenameBonus": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "SearchHit": {
        "type": "object",
        "description": "One file hit, with its score and match highlighting.\n\nThe engine returns items, scores and match offsets as three parallel arrays; they are\nzipped here. Nothing is lost, and a generated C# client is far better for it.",
        "required": [
          "item",
          "score",
          "matchRangesUtf16"
        ],
        "properties": {
          "item": {
            "$ref": "#/components/schemas/FileItemDto"
          },
          "matchRangesUtf16": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Utf16Range"
            },
            "description": "Which parts of `item.relativePath` matched, in UTF-16 code units. The MCP server\ndiscards this information entirely."
          },
          "score": {
            "$ref": "#/components/schemas/ScoreDto"
          }
        }
      },
      "SearchRequest": {
        "type": "object",
        "description": "Search request. Supply `query`, or `structured`, or neither (an empty query ranks the\nwhole index by frecency). Supplying both is rejected rather than silently preferring one.",
        "properties": {
          "comboBoostMultiplier": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Query-history combo boost. Only has an effect once a client reports selections via\n`track-query`."
          },
          "currentFile": {
            "type": [
              "string",
              "null"
            ],
            "description": "A path to deprioritise, so the file a caller is already looking at does not dominate\nits own results. Also feeds the distance bonus for nearby paths."
          },
          "maxThreads": {
            "type": [
              "integer",
              "null"
            ],
            "description": "0 lets the engine choose.",
            "minimum": 0
          },
          "minComboCount": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "page": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Zero-based page index.",
            "minimum": 0
          },
          "pageSize": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Defaults to `defaults.page_size`.",
            "minimum": 0
          },
          "query": {
            "type": [
              "string",
              "null"
            ],
            "description": "The raw fff query DSL, e.g. `git:modified src/**/*.rs !tests/ user controller`.\nPassed to the engine byte-for-byte. Glob separators must be `/`.",
            "example": "src/**/*.rs button"
          },
          "structured": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/StructuredQuery",
                "description": "Constraints as data, instead of a DSL string."
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "SearchResponse": {
        "type": "object",
        "required": [
          "items",
          "totalMatched",
          "totalFiles",
          "page",
          "pageSize",
          "hasMore"
        ],
        "properties": {
          "hasMore": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchHit"
            }
          },
          "location": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LocationDto",
                "description": "A `file.ts:42:10` suffix parsed out of the query, if present."
              }
            ]
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "pageSize": {
            "type": "integer",
            "minimum": 0
          },
          "totalFiles": {
            "type": "integer",
            "description": "Files in the index.",
            "minimum": 0
          },
          "totalMatched": {
            "type": "integer",
            "description": "Matches across the whole index, not just this page.",
            "minimum": 0
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Non-fatal notes about the query — currently backslashes in glob-looking tokens,\nwhich would otherwise match nothing with no explanation."
          }
        }
      },
      "StructuredQuery": {
        "type": "object",
        "description": "Constraints as data, for clients that would rather not build DSL strings.\n\nSeparators are folded in `globs`, `pathSegments`, `filePaths` and `excludePathSegments`,\nwhere a separator is unambiguously a separator. The engine's glob backend treats **only**\n`/` as a separator, so without folding `src\\**\\*.rs` would not be applied as a glob at\nall — it would fall through to fuzzy text matching and quietly return unrelated results.",
        "properties": {
          "excludePathSegments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Path segments to exclude."
          },
          "excludeText": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Literal text to exclude."
          },
          "extensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Bare extensions, without a dot: `rs`, `md`."
          },
          "filePaths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Exact repo-relative file paths."
          },
          "fileTypes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Engine file-type names, e.g. `rust`."
          },
          "fuzzy": {
            "type": [
              "string",
              "null"
            ],
            "description": "Free-text fuzzy terms. Split on whitespace into parts, as the DSL parser would."
          },
          "gitStatus": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/GitStatusConstraint"
              }
            ]
          },
          "globs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Glob patterns, e.g. `src/**/*.rs`."
          },
          "pathSegments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Path segments a result must contain, e.g. `src`."
          },
          "text": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Literal text a path must contain."
          }
        },
        "additionalProperties": false
      },
      "Utf16Range": {
        "type": "object",
        "description": "A half-open range of **UTF-16 code units**.\n\nThe engine produces UTF-8 byte offsets. Those are converted here because .NET strings\nare UTF-16: a byte offset would silently address the wrong characters on any line\ncontaining non-ASCII, and the point of this API is that the client does no\npost-processing.",
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "end": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "start": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "WaitFor": {
        "type": "string",
        "description": "How far creation should block before answering.",
        "enum": [
          "scan",
          "indexing",
          "watcher"
        ]
      },
      "WorkspaceList": {
        "type": "object",
        "description": "Listing response.",
        "required": [
          "workspaces"
        ],
        "properties": {
          "workspaces": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkspaceResource"
            }
          }
        }
      },
      "WorkspaceResource": {
        "type": "object",
        "description": "A workspace as clients see it.",
        "required": [
          "id",
          "root",
          "isNetworkPath",
          "status",
          "isScanning",
          "isWarmupComplete",
          "isWatcherReady",
          "indexedFiles",
          "scannedFilesCount",
          "hasGitRepo",
          "createdAt",
          "timeToReadyMs",
          "lastScanAt",
          "rescanIntervalSecs",
          "idleTimeoutSecs",
          "options"
        ],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "gitRoot": {
            "type": [
              "string",
              "null"
            ],
            "description": "Git worktree root, if one was discovered."
          },
          "hasGitRepo": {
            "type": "boolean"
          },
          "id": {
            "type": "string",
            "description": "Stable identifier, derived from the directory's filesystem identity. Re-creating the\nsame root — under any spelling, and across server restarts — returns this same id.",
            "example": "9a4f1c2b7e0d5613"
          },
          "idleTimeoutSecs": {
            "type": "integer",
            "format": "int64",
            "description": "Effective idle-eviction timeout, derived from `timeToReadyMs`.",
            "minimum": 0
          },
          "indexedFiles": {
            "type": "integer",
            "description": "Files currently in the index.",
            "minimum": 0
          },
          "isNetworkPath": {
            "type": "boolean",
            "description": "True when the root resolved to a UNC path, mapped drives included. Reported for\nvisibility only: freshness and eviction key off measured cost, not path type."
          },
          "isScanning": {
            "type": "boolean"
          },
          "isWarmupComplete": {
            "type": "boolean",
            "description": "The content index is built. Fuzzy grep needs this, and the watcher is installed only\nafter it completes."
          },
          "isWatcherReady": {
            "type": "boolean"
          },
          "lastScanAt": {
            "type": "string",
            "format": "date-time"
          },
          "options": {
            "$ref": "#/components/schemas/EffectiveOptions",
            "description": "The settings this workspace was actually built with."
          },
          "rescanIntervalSecs": {
            "type": "integer",
            "format": "int64",
            "description": "Effective automatic rescan interval, derived from `timeToReadyMs`.",
            "minimum": 0
          },
          "root": {
            "type": "string",
            "description": "The resolved root, with any verbatim `\\\\?\\` prefix stripped. Display-and-open safe;\nnot an identity key.",
            "example": "\\\\server\\share\\project"
          },
          "scannedFilesCount": {
            "type": "integer",
            "description": "Files seen by the most recent scan.",
            "minimum": 0
          },
          "status": {
            "$ref": "#/components/schemas/WorkspaceStatus"
          },
          "timeToReadyMs": {
            "type": "integer",
            "format": "int64",
            "description": "Time from construction to the readiness stage the creating call waited for. Drives\nboth derived intervals below.",
            "minimum": 0
          }
        }
      },
      "WorkspaceStatus": {
        "type": "string",
        "description": "Readiness, as a single field a client can branch on.",
        "enum": [
          "initialising",
          "indexing",
          "ready"
        ]
      }
    }
  },
